# Bitbucket CLI Configuration
# Copy this file to .env and fill in your values

# Bitbucket username
BB_USERNAME=

# Bitbucket API token (create at: https://bitbucket.org/account/settings/api-tokens/)
# Note: app passwords are deprecated — use API tokens or OAuth.
BB_API_TOKEN=

# Default workspace (optional)
BB_WORKSPACE=

# Log all HTTP traffic to Bitbucket when true
DEBUG=false
