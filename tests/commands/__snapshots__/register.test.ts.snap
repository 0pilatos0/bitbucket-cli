exports[`command tree snapshot bb branch-restriction create 1`] = `
{
  "dispatch": {
    "contextOptions": undefined,
    "options": {
      "branchType": "branchType-value",
      "group": [
        "group-value",
      ],
      "kind": "kind-value",
      "pattern": "pattern-value",
      "user": [
        "user-value",
      ],
      "value": "value-value",
    },
    "token": "CreateBranchRestrictionCommand",
    "via": "runWithGlobalOptions",
  },
  "help": 
"Usage: bb branch-restriction create [options]

Create a branch restriction rule

Options:
  --kind <kind>         Restriction kind (required) (choices: "push", "delete",
                        "force", "restrict_merges",
                        "require_tasks_to_be_completed",
                        "require_approvals_to_merge",
                        "require_review_group_approvals_to_merge",
                        "require_default_reviewer_approvals_to_merge",
                        "require_no_changes_requested",
                        "require_passing_builds_to_merge",
                        "require_commits_behind",
                        "reset_pullrequest_approvals_on_change",
                        "smart_reset_pullrequest_approvals",
                        "reset_pullrequest_changes_requested_on_change",
                        "require_all_dependencies_merged",
                        "enforce_merge_checks",
                        "allow_auto_merge_when_builds_pass",
                        "require_all_comments_resolved")
  --pattern <glob>      Branch glob pattern, e.g. main or release/*
  --branch-type <type>  Branching-model branch type (instead of --pattern)
                        (choices: "feature", "bugfix", "release", "hotfix",
                        "development", "production")
  --value <number>      Kind-specific count, e.g. minimum approvals or passing
                        builds
  --user <user>         Exempt a user by account ID or {uuid} (repeatable; push
                        and restrict_merges only) (default: [])
  --group <slug>        Exempt a workspace group by slug (repeatable; push and
                        restrict_merges only) (default: [])
  -h, --help            display help for command

Examples:
  $ bb branch-restriction create --kind force --pattern main
  $ bb branch-restriction create --kind require_approvals_to_merge --pattern main --value 2
  $ bb branch-restriction create --kind push --branch-type production --group release-managers
  $ bb branch-restriction create --kind delete --pattern 'release/*' --json --jq '.branchRestriction.id'

Valid kinds:
  push, delete, force, restrict_merges, require_tasks_to_be_completed, require_approvals_to_merge, require_review_group_approvals_to_merge, require_default_reviewer_approvals_to_merge, require_no_changes_requested, require_passing_builds_to_merge, require_commits_behind, reset_pullrequest_approvals_on_change, smart_reset_pullrequest_approvals, reset_pullrequest_changes_requested_on_change, require_all_dependencies_merged, enforce_merge_checks, allow_auto_merge_when_builds_pass, require_all_comments_resolved

Valid branch types:
  feature, bugfix, release, hotfix, development, production

"
,
}
`;

