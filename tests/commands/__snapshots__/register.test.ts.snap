Commands:
  clone [options] <repository>   Clone a Bitbucket repository
  create [options] <name>        Create a new repository
  list [options]                 List repositories
  view [repository]              View repository details
  delete [options] <repository>  Delete a repository
  default-reviewers              Manage default reviewers for a repository
  help [command]                 display help for command
"
,
}
`;

