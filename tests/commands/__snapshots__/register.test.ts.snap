// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`command tree snapshot bb auth 1`] = `
{
  "help": 
"Usage: bb auth [options] [command]

Authenticate with Bitbucket

Options:
  -h, --help       display help for command

Commands:
  login [options]  Authenticate with Bitbucket (OAuth or API token)
  logout           Log out of Bitbucket
  status           Show authentication status
  token            Print the current access token
  help [command]   display help for command
"
,
}
`;

exports[`command tree snapshot bb auth login 1`] = `
{
  "dispatch": {
    "options": {
      "appPassword": true,
      "clientId": "clientId-value",
      "clientSecret": "clientSecret-value",
      "password": "password-value",
      "username": "username-value",
      "withToken": true,
    },
    "token": "LoginCommand",
    "via": "run",
  },
  "help": 
"
Default: OAuth (browser-based, recommended).
For CI/CD: API token via --app-password or BB_API_TOKEN env var.
For headless/secret-safe: pipe the token in with --with-token.
OAuth needs a loopback browser (http://localhost:19872/callback); there
is no device-code flow, so use token auth on headless hosts.
Note: Bitbucket app passwords are deprecated; use OAuth or an API token.

Usage: bb auth login [options]

Authenticate with Bitbucket (OAuth or API token)

Options:
  -u, --username <username>       Bitbucket username (implies API token auth)
  -p, --password <password>       Bitbucket API token (implies API token auth)
  --app-password                  Use API token authentication (instead of
                                  OAuth). App passwords are deprecated; use API
                                  tokens.
  --with-token                    Read the API token from stdin (keeps it out of
                                  shell history and process args)
  --client-id <clientId>          Custom OAuth consumer client ID
  --client-secret <clientSecret>  Custom OAuth consumer client secret
  -h, --help                      display help for command

Examples:
  $ bb auth login
  $ bb auth login --app-password -u myuser -p mytoken
  $ echo "$BB_API_TOKEN" | bb auth login -u myuser --with-token
  $ bb auth login --client-id <id>
  $ BB_USERNAME=myuser BB_API_TOKEN=mytoken bb auth login

Environment variables:
  BB_USERNAME   Used when --username is not provided
  BB_API_TOKEN  Used when --password is not provided (implies API token auth)

"
,
}
`;

