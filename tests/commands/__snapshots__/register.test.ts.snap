exports[`command tree snapshot bb browse 1`] = `
{
  "dispatch": {
    "contextOptions": undefined,
    "options": {
      "branch": "branch-value",
      "branches": true,
      "browser": true,
      "commit": "commit-value",
      "commits": true,
      "downloads": true,
      "pipeline": "pipeline-value",
      "pipelines": true,
      "pr": "pr-value",
      "prs": true,
      "pullRequests": true,
      "settings": true,
      "target": "target-value",
    },
    "token": "BrowseCommand",
    "via": "runWithGlobalOptions",
  },
  "help": 
"Usage: bb browse [options] [target]

Open a Bitbucket page (repo home, file, PR, commit, etc.) in your browser

Options:
  --pr <id>         Open a specific pull request
  --prs             Open the pull-requests list
  --pull-requests   Alias for --prs
  --branch <name>   Open the branch source tree (or, with <target>, that path on
                    the branch)
  --branches        Open the branches list
  --commit [sha]    Open a specific commit (defaults to HEAD when no SHA is
                    given)
  --commits         Open the commits list
  --pipelines       Open the pipelines page
  --pipeline <id>   Open a specific pipeline run
  --downloads       Open the downloads page
  --settings        Open repository settings
  -n, --no-browser  Print the URL to stdout instead of opening it
  -h, --help        display help for command

Examples:
  $ bb browse
  $ bb browse src/cli.ts
  $ bb browse src/cli.ts:42
  $ bb browse --branch release/2.0 src/cli.ts
  $ bb browse 217
  $ bb browse --pr 217
  $ bb browse --prs
  $ bb browse abc1234
  $ bb browse --commit
  $ bb browse --pipelines
  $ bb browse --settings
  $ bb browse --pr 217 --no-browser
  $ bb browse --pr 217 --json url

"
,
}
`;

exports[`command tree snapshot bb api 1`] = `
{
  "dispatch": {
    "contextOptions": {
      "allowJqWithoutJson": true,
    },
    "options": {
      "endpoint": "endpoint-value",
      "field": [
        "field-value",
      ],
      "header": [
        "header-value",
      ],
      "include": true,
      "input": "input-value",
      "method": "method-value",
      "methodOrEndpoint": "methodOrEndpoint-value",
      "paginate": true,
      "rawField": [
        "rawField-value",
      ],
    },
    "token": "ApiCommand",
    "via": "runWithGlobalOptions",
  },
  "help": 
"
Escape hatch for endpoints not yet wrapped by a typed command.
The path is relative to https://api.bitbucket.org/2.0; {workspace} and
{repo} placeholders are filled from --workspace/--repo or the current repo.

Usage: bb api [options] [methodOrEndpoint] [endpoint]

Make an authenticated request to any Bitbucket Cloud 2.0 API endpoint

Options:
  -X, --method <method>        HTTP method (GET, POST, PUT, PATCH, DELETE, HEAD,
                               OPTIONS). Defaults to GET, or POST when
                               fields/body are present. (choices: "GET", "POST",
                               "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS")
  -f, --raw-field <key=value>  Add a string parameter — query param on GET/HEAD,
                               JSON body field otherwise (repeatable) (default:
                               [])
  -F, --field <key=value>      Add a typed parameter: true/false/null and
                               numbers are converted; @file reads a file and @-
                               reads stdin (repeatable) (default: [])
  --input <file>               Read the request body from a file, or - for stdin
                               (sent as application/json; mutually exclusive
                               with -f/-F)
  -H, --header <key:value>     Add a request header (repeatable). Authorization
                               is managed automatically and cannot be set here.
                               (default: [])
  -i, --include                Print the HTTP status line and response headers
                               before the body, on success and failure (text
                               mode only)
  --paginate                   Follow the cursor (next) and merge every page
                               into a single {"values": [...]} result (GET/HEAD
                               only)
  -h, --help                   display help for command

Examples:
  $ bb api /user
  $ bb api GET /user
  $ bb api /repositories/{workspace}/{repo}/pullrequests --paginate
  $ bb api POST /repositories/my-ws/my-repo/pipelines/ -f target.commit=abc1234
  $ bb api PUT /repositories/my-ws/my-repo/pullrequests/42 --input body.json
  $ cat body.json | bb api POST /repositories/my-ws/my-repo/pullrequests/42/comments --input -
  $ bb api /repositories/my-ws --jq '.values[].name'
  $ bb api -i /user

Valid methods:
  GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS

See also:
  Scripting & Automation  https://bitbucket-cli.paulvanderlei.com/guides/scripting/
  Bitbucket REST API      https://developer.atlassian.com/cloud/bitbucket/rest/intro/

"
,
}
`;

exports[`command tree snapshot bb alias 1`] = `
{
  "help": 
"Usage: bb alias [options] [command]

Create shortcuts for bb commands

Options:
  -h, --help              display help for command

Commands:
  set <name> <expansion>  Create or update an alias; supports $1-$9 placeholders
                          and a ! prefix for shell passthrough
  list                    List configured aliases
  delete <name>           Delete an alias
  help [command]          display help for command
"
,
}
`;

exports[`command tree snapshot bb alias set 1`] = `
{
  "dispatch": {
    "options": {
      "expansion": "expansion-value",
      "name": "name-value",
    },
    "token": "SetAliasCommand",
    "via": "run",
  },
  "help": 
"
An alias expands in place of the first bb argument: \`bb co 42\` runs
\`bb pr checkout 42\` after \`bb alias set co "pr checkout $1"\`. Extra
arguments are appended unless consumed by $1-$9 placeholders. A \`!\`
prefix runs the expansion through \`sh -c\` instead, with the remaining
arguments available as shell positional parameters ($1, $@).

Usage: bb alias set [options] <name> <expansion>

Create or update an alias; supports $1-$9 placeholders and a ! prefix for shell
passthrough

Options:
  -h, --help  display help for command

Examples:
  $ bb alias set co "pr checkout $1"
  $ bb alias set prd "pr create --draft"
  $ bb alias set openpr '!bb pr list --json --jq ".pullRequests[0].id" | xargs bb browse --pr'

See also:
