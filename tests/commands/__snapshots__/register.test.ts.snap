exports[`command tree snapshot bb pipeline list 1`] = `
{
  "dispatch": {
    "contextOptions": undefined,
    "options": {
      "all": true,
      "branch": "branch-value",
      "limit": "limit-value",
      "sort": "sort-value",
      "status": "status-value",
    },
    "token": "ListPipelinesCommand",
    "via": "runWithGlobalOptions",
  },
  "help": 
"Usage: bb pipeline list [options]

List pipelines for a repository

Options:
  --status <status>   Filter by pipeline status (choices: "PARSING", "PENDING",
                      "PAUSED", "HALTED", "BUILDING", "ERROR", "PASSED",
                      "FAILED", "STOPPED", "UNKNOWN")
  --branch <branch>   Filter by target branch
  --sort <attribute>  Sort attribute (prefix with - for descending) (choices:
                      "creator.uuid", "-creator.uuid", "created_on",
                      "-created_on", "run_creation_date", "-run_creation_date")
  --limit <number>    Maximum number of pipelines to list (default: "25")
  --all               List all pipelines (overrides --limit)
  -h, --help          display help for command

Examples:
  $ bb pipeline list
  $ bb pipeline list --status FAILED
  $ bb pipeline list --branch main --limit 50
  $ bb pipeline list --json --jq '.pipelines[].build_number'

Valid statuses:
  PARSING, PENDING, PAUSED, HALTED, BUILDING, ERROR, PASSED, FAILED, STOPPED, UNKNOWN

Valid sort attributes:
  creator.uuid, -creator.uuid, created_on, -created_on, run_creation_date, -run_creation_date

Defaults:
  --limit  25
  --sort  -created_on

"
,
}
`;

