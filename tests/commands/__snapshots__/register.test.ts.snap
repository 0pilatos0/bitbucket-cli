  list [options]           List pull requests
  view <id>                View pull request details
  activity [options] <id>  Show pull request activity log
  checks <id>              Show CI/CD checks and build status for a pull request
  edit [options] [id]      Edit a pull request
  merge [options] <id>     Merge a pull request
  approve <id>             Approve a pull request
  decline <id>             Decline a pull request
  ready <id>               Mark a draft pull request as ready for review
  checkout <id>            Checkout a pull request locally
  diff [options] [id]      View pull request diff
  comments                 Manage pull request comments
  reviewers                Manage pull request reviewers
  help [command]           display help for command
"
,
}
`;

exports[`command tree snapshot bb pr create 1`] = `
{
  "dispatch": {
    "contextOptions": undefined,
    "options": {
      "body": "body-value",
      "closeSourceBranch": true,
      "defaultReviewers": true,
      "destination": "destination-value",
      "draft": true,
      "reviewer": [
        "reviewer-value",
      ],
      "source": "source-value",
      "title": "title-value",
    },
    "token": "CreatePRCommand",
    "via": "runWithGlobalOptions",
  },
  "help": 
"Usage: bb pr create [options]

Create a pull request

Options:
  -t, --title <title>         Pull request title
  -b, --body <body>           Pull request description
  -s, --source <branch>       Source branch (default: current branch)
  -d, --destination <branch>  Destination branch (default: main)
  --close-source-branch       Close source branch after merge
  --draft                     Create the pull request as draft
  --reviewer <user>           Add a reviewer by account ID or {uuid}
                              (repeatable) (default: [])
  --default-reviewers         Include the repository's default reviewers
  --no-default-reviewers      Skip the repository's default reviewers even when
                              prCreateIncludeDefaultReviewers is true
  -h, --help                  display help for command

Examples:
  $ bb pr create -t "My PR" -b "Description"
  $ bb pr create -t "My PR" --draft
  $ bb pr create -t "My PR" -s feature -d develop
  $ bb pr create -t "My PR" --close-source-branch
  $ bb pr create -t "My PR" --default-reviewers
  $ bb pr create -t "My PR" --reviewer jdoe --reviewer asmith

Defaults:
  --source  current git branch
  --destination  main
  --default-reviewers  false (override with --default-reviewers or config key prCreateIncludeDefaultReviewers)

See also:
  Repository Context  https://bitbucket-cli.paulvanderlei.com/guides/repository-context/
  Default reviewers   https://bitbucket-cli.paulvanderlei.com/commands/repo/#bb-repo-default-reviewers

"
,
}
`;

exports[`command tree snapshot bb pr list 1`] = `
{
  "dispatch": {
    "contextOptions": undefined,
    "options": {
      "all": true,
      "limit": "limit-value",
      "mine": true,
      "state": "state-value",
    },
    "token": "ListPRsCommand",
    "via": "runWithGlobalOptions",
  },
  "help": 
"Usage: bb pr list [options]

List pull requests

Options:
  -s, --state <state>  Filter by state (OPEN, MERGED, DECLINED, SUPERSEDED)
                       (choices: "OPEN", "MERGED", "DECLINED", "SUPERSEDED",
                       default: "OPEN")
  --limit <number>     Maximum number of PRs to list (default: "25")
  --all                List all pull requests (overrides --limit)
  --mine               Show only PRs where you are a reviewer (not authored by
                       you)
  -h, --help           display help for command

Examples:
  $ bb pr list
  $ bb pr list -s MERGED --limit 10
  $ bb pr list --all
  $ bb pr list --mine
  $ bb pr list --json

Valid states:
  OPEN, MERGED, DECLINED, SUPERSEDED

Defaults:
  --state  OPEN
  --limit  25

See also:
  Scripting & Automation  https://bitbucket-cli.paulvanderlei.com/guides/scripting/
  JSON Output             https://bitbucket-cli.paulvanderlei.com/reference/json-output/

"
,
}
`;

