---
/**
 * Ascetic session example — terminal block built from explicit
 * line rows (no <pre> whitespace fragility), with a blinking
 * caret as the single motion nod. Copy mirrors the quickstart:
 * repository context resolved from the git remote.
 */
---

<div class="bb-session">
  <div class="bar">
    <span>example — run from any Bitbucket checkout</span>
    <span>context is automatic</span>
  </div>
  <div class="body">
    <div class="ln c"># workspace and repo resolved from your git remote</div>
    <div class="gap"></div>
    <div class="ln"><span class="p">$</span><span>bb pr list <span class="k">--state</span> OPEN</span></div>
    <div class="ln out g">#47   feat: streaming pipeline logs   OPEN</div>
    <div class="ln out g">#46   fix: retry on 429 rate limits   OPEN</div>
    <div class="gap"></div>
    <div class="ln"><span class="p">$</span><span>bb pr merge <span class="k">47</span> <span class="k">--strategy</span> squash</span></div>
    <div class="ln out ok">✓ Merged pull request #47 into main (squash)</div>
    <div class="gap"></div>
    <div class="ln"><span class="p">$</span><span>bb pipeline run <span class="k">--branch</span> main <span class="k">--json</span> <span class="k">--jq</span> <span class="k">'.build_number'</span></span></div>
    <div class="ln out g">313<span class="caret" aria-hidden="true"></span></div>
  </div>
</div>

<style>
  .bb-session {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bb-bg-sub);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1.125rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    font-family: var(--bb-font-mono);
    font-size: 0.6875rem;
    color: var(--bb-fg-3);
    letter-spacing: 0.05em;
  }
  .body {
    padding: 1rem 1.125rem 1.125rem;
    font-family: var(--bb-font-mono);
    font-size: 0.7938rem;
    line-height: 1.6;
    overflow-x: auto;
  }
  .ln {
    display: flex;
    align-items: baseline;
    white-space: pre;
  }
  .ln .p {
    color: var(--bb-fg-3);
    user-select: none;
    width: 1.375rem;
    flex: 0 0 1.375rem;
  }
  .ln.out {
    padding-left: 1.375rem;
  }
  .ln.c {
    color: var(--bb-fg-3);
  }
  .ln :global(.k) {
    color: var(--sl-color-accent);
  }
  .ln.g {
    color: var(--sl-color-fg-muted);
  }
  .ln.ok {
    color: var(--bb-ok);
  }
  .gap {
    height: 0.9em;
  }
  .caret {
    display: inline-block;
    width: 0.5rem;
    height: 0.9375rem;
    background: var(--sl-color-fg-muted);
    margin-left: 0.25rem;
    vertical-align: text-bottom;
    animation: bb-blink 1.2s steps(1) infinite;
  }
  @keyframes bb-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
