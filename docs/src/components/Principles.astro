---
/**
 * Output and runtime behavior at a glance.
 */
const principles = [
  {
    title: 'Machines are users too',
    body: 'Use <code>--json</code> for structured output and <code>--jq</code> to select values. See the <a href="/reference/json-output/">JSON reference</a> for command shapes and projection limits.',
  },
  {
    title: 'No jq dependency',
    body: '<code>--jq</code> evaluates in-process without an external jq binary. Windows requires Bun 1.4.2+.',
  },
  {
    title: 'Error codes you can branch on',
    body: 'Command errors under <code>--json</code> include a numeric <code>code</code>. Argument-parser errors can remain plain text; interrupted prompts exit with <code>130</code>.',
  },
  {
    title: 'Generated API client',
    body: 'The API client is generated from one pinned OpenAPI spec; CI fails if the generated code drifts from it.',
  },
  {
    title: 'Local credential storage',
    body: 'Credentials are stored with <code>0600</code> permissions in your platform\'s config directory. The file holds plaintext credentials. <code>bb auth token</code> deliberately prints credentials for scripts.',
  },
];
---

<div class="bb-principles-block">
  <div class="bb-refhead">
    <span>Principles</span>
    <span class="cnt">why it's built this way</span>
  </div>
  <div class="bb-principles">
    {
      principles.map((p, i) => (
        <div class="p">
          <span class="no">{String(i + 1).padStart(2, '0')}</span>
          <span>
            <b>{p.title}</b>
            <Fragment set:html={p.body} />
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .bb-refhead {
    font-family: var(--bb-font-mono);
    font-size: 0.7188rem;
    font-weight: 500;
    color: var(--bb-fg-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.125rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .bb-refhead .cnt {
    letter-spacing: 0;
    text-transform: none;
  }
  .bb-principles {
    display: grid;
  }
  .p {
    display: grid;
    grid-template-columns: 1.875rem 1fr;
    gap: 0.75rem;
    padding: 0.8125rem 0;
    border-bottom: 1px solid var(--sl-color-hairline);
    font-size: 0.8438rem;
    color: var(--sl-color-fg-muted);
    line-height: 1.6;
  }
  .p:last-child {
    border-bottom: none;
  }
  .p .no {
    font-family: var(--bb-font-mono);
    font-size: 0.6875rem;
    color: var(--bb-fg-3);
    padding-top: 0.1563rem;
    transition: color 140ms;
  }
  .p:hover .no {
    color: var(--sl-color-accent);
  }
  .p b {
    color: var(--sl-color-fg);
    font-weight: 500;
    display: block;
    margin-bottom: 0.125rem;
  }
  .p :global(code) {
    font-family: var(--bb-font-mono);
    font-size: 0.84em;
    color: var(--sl-color-fg);
    background: var(--bb-bg-sub);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 4px;
    padding: 1px 5px;
  }
</style>
