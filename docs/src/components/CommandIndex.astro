---
/**
 * Command groups with descriptions and example invocations.
 */
const groups = [
  { n: 'bb pr', d: 'full pull-request lifecycle, comments, reviewers', ex: 'bb pr merge 42 --strategy squash' },
  { n: 'bb repo', d: 'clone, create, list, view, delete', ex: 'bb repo clone workspace/repo' },
  { n: 'bb pipeline', d: 'run, view, logs, stop', ex: 'bb pipeline logs 42' },
  { n: 'bb commit', d: 'commit history and details', ex: 'bb commit list --limit 10' },
  { n: 'bb snippet', d: 'create and share snippets', ex: 'bb snippet create -t notes -f a.txt' },
  { n: 'bb config', d: 'manage local configuration', ex: 'bb config set defaultWorkspace myworkspace' },
  { n: 'bb auth', d: 'login, logout, status, token', ex: 'bb auth login' },
  { n: 'bb project', d: 'projects inside workspaces', ex: 'bb project view PROJ' },
  { n: 'bb webhook', d: 'repository and workspace webhooks', ex: 'bb webhook list' },
  { n: 'bb branch-restriction', d: 'branch protection rules', ex: 'bb branch-restriction list' },
  { n: 'bb deployment', d: 'deployments and environments', ex: 'bb deployment list' },
  { n: 'bb ssh-key', d: 'SSH keys on your account', ex: 'bb ssh-key add ~/.ssh/id_ed25519.pub' },
  { n: 'bb gpg-key', d: 'GPG keys for signed commits', ex: 'bb gpg-key list' },
  { n: 'bb workspace', d: 'workspaces you belong to', ex: 'bb workspace list' },
  { n: 'bb status', d: 'publish commit build statuses', ex: 'bb status set abc1234 --key build --state SUCCESSFUL' },
  { n: 'bb alias', d: 'personal command shortcuts', ex: "bb alias set co 'pr checkout'" },
  { n: 'bb search', d: 'code search across a workspace', ex: 'bb search code parseConfig' },
  { n: 'bb browse', d: 'open the web UI at PRs, files, lines', ex: 'bb browse src/cli.ts:20' },
  { n: 'bb api', d: 'raw 2.0 endpoints, paginated', ex: 'bb api /user' },
  { n: 'bb completion', d: 'shell completions', ex: 'bb completion install' },
];
---

<div class="bb-commands">
  <div class="bb-refhead">
    <span>Commands</span>
    <span class="cnt">{groups.length} command groups</span>
  </div>
  <div class="bb-groups">
    {
      groups.map((g) => (
        <a class="group" href={`/commands/${g.n.split(' ')[1]}/`}>
          <span class="n">{g.n}</span>
          <span class="d">{g.d}</span>
          <span class="right">
            <span class="ex">{g.ex}</span>
          </span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .bb-refhead {
    font-family: var(--bb-font-mono);
    font-size: 0.7188rem;
    font-weight: 500;
    color: var(--bb-fg-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.125rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .bb-refhead .cnt {
    letter-spacing: 0;
    text-transform: none;
  }
  .bb-groups {
    display: grid;
  }
  .group {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.5625rem 0.625rem;
    margin: 0 -0.625rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    align-items: baseline;
    font-size: 0.8125rem;
    line-height: 1.5;
    border-radius: 6px;
    transition: background 140ms;
    text-decoration: none;
  }
  .group:hover {
    text-decoration: none;
  }
  .group:last-child {
    border-bottom: none;
  }
  .group .n {
    font-family: var(--bb-font-mono);
    font-size: 0.7813rem;
    color: var(--sl-color-fg);
    transition: color 140ms;
  }
  .group .d {
    color: var(--bb-fg-3);
  }
  .group .right {
    grid-column: 2;
    font-family: var(--bb-font-mono);
    font-size: 0.7188rem;
    color: var(--bb-fg-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .group .right .ex {
    color: var(--bb-fg-3);
  }
  .group:hover {
    background: var(--bb-bg-sub);
  }
  .group:hover .n {
    color: var(--sl-color-accent);
  }

  @media (max-width: 800px) {
    .group {
      grid-template-columns: 1fr;
    }
    .group .right {
      display: none;
    }
  }
</style>
